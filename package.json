{
  "name": "coil",
  "version": "0.0.1",
  "description": "One thread, one agent, one computer. Pi Durable and a Cloudflare container per thread, compacted together.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acoyfellow/coil.git"
  },
  "scripts": {
    "dev": "node scripts/build-term.mjs && wrangler dev",
    "deploy": "node scripts/build-term.mjs && wrangler deploy",
    "typecheck": "node scripts/build-term.mjs && tsc -p . && tsc -p tsconfig.client.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "check": "node scripts/build-term.mjs && bash scripts/check.sh",
    "build:term": "node scripts/build-term.mjs",
    "ship": "bash scripts/ship.sh",
    "ship:all": "bash scripts/ship-all.sh"
  },
  "dependencies": {
    "@cloudflare/sandbox": "1.0.3",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/merge": "6.12.3",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "@effect/platform-browser": "4.1.2",
    "@novnc/novnc": "1.7.0",
    "cloudterm": "github:acoyfellow/cloudterm#2fbaeb4",
    "codemirror": "6.0.2",
    "effect": "4.1.2",
    "foldkit": "0.170.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@cloudflare/workers-types": "^5.20261102.1",
    "@foldkit/vite-plugin": "0.29.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "lucide-static": "^1.66.0",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "4.156.1"
  }
}
