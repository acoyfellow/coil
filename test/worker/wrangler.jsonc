{
  "name": "coil-test",
  "main": "index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "worker_loaders": [{ "binding": "LOADER" }],
  "durable_objects": {
    "bindings": [
      { "name": "THREAD", "class_name": "TestThread" },
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "TEST_DIRECTORY", "class_name": "ScriptedDirectory" },
      { "name": "TEST_CONNECTORS", "class_name": "ScriptedConnectorStore" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "TestThread",
        "Directory",
        "ScriptedDirectory",
        "ScriptedConnectorStore"
      ]
    }
  ]
}
